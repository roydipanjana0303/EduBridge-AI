DB_URL=jdbc:postgresql://localhost:5432/edubridge
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Base64-encoded secret, at least 32 bytes decoded. Generate: openssl rand -base64 48
APP_JWT_SECRET=change-me-base64
APP_JWT_EXPIRATION=86400000
# Optional (voice rooms). LIVEKIT_API_SECRET must be >= 32 characters.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
REDIS_HOST=localhost
REDIS_PORT=6379
